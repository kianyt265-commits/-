# ==============================================================
#  V2Box Panel — environment variables
#  copy to .env  ->  cp .env.example .env   then edit the values
# ==============================================================

# --- security -------------------------------------------------
# generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- first admin (created automatically on first boot) --------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- database -------------------------------------------------
DATABASE_URL=sqlite:////app/data/v2box.db

# --- xray -----------------------------------------------------
XRAY_CONFIG_PATH=/etc/xray/config.json
XRAY_CONTAINER_NAME=xray-core
XRAY_API_HOST=127.0.0.1
XRAY_API_PORT=10085
XRAY_ACCESS_LOG=/var/log/xray/access.log

# --- panel behaviour ------------------------------------------
# interval (seconds) of the background job:
#   * disable expired / over-quota users
#   * collect traffic statistics
#   * re-sync xray config
SYNC_INTERVAL=60

# seed the database with a realistic sample dataset on a fresh install
# (8 users on the shipped inbounds + 7 days of traffic history).
# set to false for a clean, empty production install.
SEED_DEMO_DATA=true

# opt-in: slowly grows the sample users' traffic counters (screenshots/demos only)
SIMULATE_TRAFFIC=false

# public address used in generated links when a server has none
PUBLIC_DOMAIN=

# hostname for the auto-generated self-signed certificate (xray entrypoint)
TLS_SNI=v2box.local

# where the backend finds frontend/share.html (docker: /app/frontend)
FRONTEND_DIR=/app/frontend
CERT_DIR=/app/certs
XRAY_BACKUP_DIR=/app/data/xray-backup

# --- ports (used by docker-compose) ---------------------------
PANEL_HTTP_PORT=80
PANEL_ALT_PORT=8080
BACKEND_PORT=8000
